---
import Badge from "@/components/Badge.astro"
import ContactMenu from "@/components/ContactMenu.astro"
import DownloadIcon from "@/components/icons/Download.astro"
import SocialPill from "@/components/SocialPill.astro"

const personalImageAlt = "David Suarez"
---

<div
  id="hero"
  class="relative flex items-center justify-center w-full overflow-hidden bg-white dark:bg-black cursor-crosshair min-h-[100svh] selection:bg-sky-500 selection:text-white"
>
  <canvas id="hero-particles" class="absolute inset-0 z-0 block w-full h-full"
  ></canvas>

  <!-- Difuminado hacia el fondo de la página -->
  <div
    class="absolute inset-x-0 bottom-0 z-[1] h-48 pointer-events-none bg-gradient-to-b from-transparent to-white dark:to-black"
  >
  </div>

  <!-- Contenido: pointer-events-none deja pasar el mouse al canvas; los enlaces lo reactivan -->
  <div class="relative z-10 max-w-2xl px-4 text-center pointer-events-none">
    <div class="flex items-center justify-center gap-4 mb-6">
      <img
        class="object-cover rounded-full shadow-lg size-20 object-[50%_30%] ring-2 ring-black/10 dark:ring-white/15"
        src="/daviddev.webp"
        alt={personalImageAlt}
      />
      <a
        href="https://www.linkedin.com/in/carlos-david-suarez-495702368/"
        target="_blank"
        rel="noopener"
        class="flex items-center transition pointer-events-auto md:hover:scale-105"
      >
        <Badge>Disponible para trabajar</Badge>
      </a>
    </div>

    <h1
      class="text-4xl font-bold tracking-tight text-transparent md:text-5xl bg-clip-text bg-gradient-to-b from-slate-800 via-slate-500 to-slate-800 dark:from-white dark:via-zinc-400 dark:to-white"
    >
      Haciendo que tu trabajo sea más fácil
    </h1>

    <p
      class="mx-auto mt-6 text-lg font-light leading-relaxed md:text-xl text-slate-600 dark:text-white/60 max-w-xl [&>strong]:text-sky-600 dark:[&>strong]:text-sky-300 [&>strong]:font-semibold"
    >
      <strong>Ingeniero de Sistemas</strong> con 2 años de experiencia, especializado
      en el desarrollo de aplicaciones web. Radicado en Pamplona, Colombia, <strong
        >comprometido con la innovación</strong
      > y la calidad en soluciones digitales.
    </p>

    <nav class="flex flex-wrap justify-center gap-4 mt-8 pointer-events-auto">
      <ContactMenu />
      <SocialPill href="/cv-carlos-suarez.pdf" download="CV-Carlos-Suarez.pdf">
        <DownloadIcon class="size-4" />
        Descargar CV
      </SocialPill>
    </nav>
  </div>

  <!-- Indicador de scroll -->
  <a
    href="#experiencia"
    aria-label="Bajar al contenido"
    class="absolute z-10 flex flex-col items-center gap-2 transition-colors -translate-x-1/2 bottom-8 left-1/2 text-slate-400 dark:text-white/30 animate-pulse hover:text-slate-600 dark:hover:text-white/70"
  >
    <span class="text-[10px] uppercase tracking-[0.2em]">Scroll</span>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M6 9l6 6l6 -6"></path>
    </svg>
  </a>
</div>

<script>
  interface Particle {
    x: number
    y: number
    originX: number
    originY: number
    vx: number
    vy: number
    size: number
    accent: boolean
  }

  interface BgParticle {
    x: number
    y: number
    vx: number
    vy: number
    size: number
    alpha: number
    phase: number
  }

  interface Palette {
    baseRgb: string // color de las partículas normales (sin alpha)
    baseAlpha: number // opacidad mínima de las partículas en reposo
    accent: string // color sólido de las partículas de acento
    star: string // color de las estrellas de fondo
    starBoost: number // intensidad de las estrellas según el tema
    glowRgb: string // color del glow radial (sin alpha)
    glowBoost: number // intensidad del glow según el tema
  }

  function getPalette(): Palette {
    const dark = document.documentElement.classList.contains("dark")
    return dark
      ? {
          baseRgb: "255, 255, 255",
          baseAlpha: 0.3,
          accent: "#38bdf8", // sky-400
          star: "#ffffff",
          starBoost: 1,
          glowRgb: "56, 189, 248",
          glowBoost: 1,
        }
      : {
          baseRgb: "51, 65, 85", // slate-700
          baseAlpha: 0.55, // más opaco para ser visible sobre blanco
          accent: "#0284c7", // sky-600
          star: "#334155", // slate-700
          starBoost: 1.7, // estrellas más marcadas sobre blanco
          glowRgb: "56, 189, 248",
          glowBoost: 1.6,
        }
  }

  function initHero() {
    const canvas = document.getElementById(
      "hero-particles"
    ) as HTMLCanvasElement | null
    if (!canvas) return
    const ctx = canvas.getContext("2d")
    const container = canvas.parentElement
    if (!ctx || !container) return

    // --- Configuración ---
    const PARTICLE_DENSITY = 0.00012
    const BG_PARTICLE_DENSITY = 0.00005
    const MAX_PARTICLES = 220
    const MOUSE_RADIUS = 180
    const RETURN_SPEED = 0.08
    const DAMPING = 0.9
    const REPULSION_STRENGTH = 1.2
    const ACCENT_RATIO = 0.85

    let particles: Particle[] = []
    let bgParticles: BgParticle[] = []
    let palette = getPalette()
    const mouse = { x: -1000, y: -1000, isActive: false }
    let rafId = 0
    let width = 0
    let height = 0
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches

    const rand = (min: number, max: number) =>
      Math.random() * (max - min) + min

    function initParticles(w: number, h: number) {
      const count = Math.min(Math.floor(w * h * PARTICLE_DENSITY), MAX_PARTICLES)
      particles = []
      for (let i = 0; i < count; i++) {
        const x = Math.random() * w
        const y = Math.random() * h
        particles.push({
          x,
          y,
          originX: x,
          originY: y,
          vx: 0,
          vy: 0,
          size: rand(1, 2.5),
          accent: Math.random() > ACCENT_RATIO,
        })
      }

      const bgCount = Math.floor(w * h * BG_PARTICLE_DENSITY)
      bgParticles = []
      for (let i = 0; i < bgCount; i++) {
        bgParticles.push({
          x: Math.random() * w,
          y: Math.random() * h,
          vx: (Math.random() - 0.5) * 0.2,
          vy: (Math.random() - 0.5) * 0.2,
          size: rand(0.5, 1.5),
          alpha: rand(0.1, 0.4),
          phase: Math.random() * Math.PI * 2,
        })
      }
    }

    function resize() {
      const rect = container!.getBoundingClientRect()
      width = rect.width
      height = rect.height
      const dpr = window.devicePixelRatio || 1
      canvas!.width = width * dpr
      canvas!.height = height * dpr
      canvas!.style.width = `${width}px`
      canvas!.style.height = `${height}px`
      // setTransform en vez de scale para no acumular en cada resize
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0)
      initParticles(width, height)
    }

    function animate(time: number) {
      ctx!.clearRect(0, 0, width, height)

      // 1. Glow radial pulsante
      const cx = width / 2
      const cy = height / 2
      const pulse = (Math.sin(time * 0.0008) * 0.035 + 0.085) * palette.glowBoost
      const g = ctx!.createRadialGradient(
        cx,
        cy,
        0,
        cx,
        cy,
        Math.max(width, height) * 0.7
      )
      g.addColorStop(0, `rgba(${palette.glowRgb}, ${pulse})`)
      g.addColorStop(1, `rgba(${palette.glowRgb}, 0)`)
      ctx!.fillStyle = g
      ctx!.fillRect(0, 0, width, height)

      // 2. Estrellas de fondo a la deriva
      ctx!.fillStyle = palette.star
      for (const p of bgParticles) {
        p.x += p.vx
        p.y += p.vy
        if (p.x < 0) p.x = width
        if (p.x > width) p.x = 0
        if (p.y < 0) p.y = height
        if (p.y > height) p.y = 0
        const twinkle = Math.sin(time * 0.002 + p.phase) * 0.5 + 0.5
        ctx!.globalAlpha = p.alpha * (0.3 + 0.7 * twinkle) * palette.starBoost
        ctx!.beginPath()
        ctx!.arc(p.x, p.y, p.size, 0, Math.PI * 2)
        ctx!.fill()
      }
      ctx!.globalAlpha = 1

      // 3. Fuerzas (repulsión del mouse + resorte hacia el origen)
      for (const p of particles) {
        const dx = mouse.x - p.x
        const dy = mouse.y - p.y
        const dist = Math.sqrt(dx * dx + dy * dy)
        if (mouse.isActive && dist < MOUSE_RADIUS && dist > 0) {
          const fx = dx / dist
          const fy = dy / dist
          const force = (MOUSE_RADIUS - dist) / MOUSE_RADIUS
          const rep = force * REPULSION_STRENGTH
          p.vx -= fx * rep * 5
          p.vy -= fy * rep * 5
        }
        p.vx += (p.originX - p.x) * RETURN_SPEED
        p.vy += (p.originY - p.y) * RETURN_SPEED
      }

      // 4. Colisiones elásticas entre partículas
      for (let i = 0; i < particles.length; i++) {
        for (let j = i + 1; j < particles.length; j++) {
          const p1 = particles[i]
          const p2 = particles[j]
          const dx = p2.x - p1.x
          const dy = p2.y - p1.y
          const distSq = dx * dx + dy * dy
          const minDist = p1.size + p2.size
          if (distSq < minDist * minDist) {
            const dist = Math.sqrt(distSq)
            if (dist > 0.01) {
              const nx = dx / dist
              const ny = dy / dist
              const overlap = minDist - dist
              const pushX = nx * overlap * 0.5
              const pushY = ny * overlap * 0.5
              p1.x -= pushX
              p1.y -= pushY
              p2.x += pushX
              p2.y += pushY

              const dvx = p1.vx - p2.vx
              const dvy = p1.vy - p2.vy
              const velAlongNormal = dvx * nx + dvy * ny
              if (velAlongNormal > 0) {
                const m1 = p1.size
                const m2 = p2.size
                const restitution = 0.85
                const impulse =
                  (-(1 + restitution) * velAlongNormal) / (1 / m1 + 1 / m2)
                const ix = impulse * nx
                const iy = impulse * ny
                p1.vx += ix / m1
                p1.vy += iy / m1
                p2.vx -= ix / m2
                p2.vy -= iy / m2
              }
            }
          }
        }
      }

      // 5. Integración + dibujo
      for (const p of particles) {
        p.vx *= DAMPING
        p.vy *= DAMPING
        p.x += p.vx
        p.y += p.vy
        ctx!.beginPath()
        ctx!.arc(p.x, p.y, p.size, 0, Math.PI * 2)
        if (p.accent) {
          ctx!.fillStyle = palette.accent
        } else {
          const v = Math.sqrt(p.vx * p.vx + p.vy * p.vy)
          const op = Math.min(palette.baseAlpha + v * 0.1, 1)
          ctx!.fillStyle = `rgba(${palette.baseRgb}, ${op})`
        }
        ctx!.fill()
      }

      if (!reduceMotion) rafId = requestAnimationFrame(animate)
    }

    function onMove(e: MouseEvent) {
      const rect = container!.getBoundingClientRect()
      mouse.x = e.clientX - rect.left
      mouse.y = e.clientY - rect.top
      mouse.isActive = true
    }
    function onLeave() {
      mouse.isActive = false
    }

    // Reacciona en vivo al cambio de tema (toggle añade/quita la clase `dark`)
    const themeObserver = new MutationObserver(() => {
      palette = getPalette()
      // Con reduced-motion el rAF no se reprograma; forzamos un frame para
      // que el canvas refleje el nuevo tema al cambiar el toggle.
      if (reduceMotion) requestAnimationFrame(animate)
    })
    themeObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["class"],
    })

    container.addEventListener("mousemove", onMove)
    container.addEventListener("mouseleave", onLeave)
    window.addEventListener("resize", resize)

    resize()
    rafId = requestAnimationFrame(animate) // dibuja al menos 1 frame (incluso con reduce-motion)

    // Limpieza al navegar (View Transitions de Astro)
    document.addEventListener(
      "astro:before-swap",
      () => {
        cancelAnimationFrame(rafId)
        themeObserver.disconnect()
        container.removeEventListener("mousemove", onMove)
        container.removeEventListener("mouseleave", onLeave)
        window.removeEventListener("resize", resize)
      },
      { once: true }
    )
  }

  document.addEventListener("astro:page-load", initHero)
</script>
